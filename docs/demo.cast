[7.64489, "o", "$ "]
[8.075148, "o", "uv run database\r\n"]
[8.595623, "o", "***База данных***"]
[8.596263, "o", "\r\n"]
[8.596532, "o", "create_table <таблица> <столбец:тип> ... — создать таблицу"]
[8.596606, "o", "\r\nlist_tables — список таблиц\r\ndrop_table <таблица> — удалить таблицу\r\ninsert into <таблица> values (<значение>, ...) — добавить запись\r\nselect from <таблица> [where <столбец> = <значение>] — выбрать записи\r\nupdate <таблица> set <столбец> = <значение> where <столбец> = <значение>\r\ndelete from <таблица> where <столбец> = <значение> — удалить записи\r\ninfo <таблица> — схема и количество записей\r\nhelp — справка\r\nexit — выход\r\n\r\n"]
[8.596805, "o", "Введите команду: "]
[15.978893, "o", "create_table users name:str age:int is_active:bool\r\nТаблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\nВведите команду: "]
[16.741291, "o", "list_tables\r\n"]
[16.742379, "o", "- users"]
[16.743036, "o", "\r\n"]
[16.744612, "o", "Введите команду: "]
[17.504599, "o", "insert into users values (\"Sergei\", 28, true)\r\nФункция insert выполнилась за 0.000 секунд."]
[17.504976, "o", "\r\n"]
[17.50599, "o", "Запись с ID=1 успешно добавлена в таблицу \"users\"."]
[17.506491, "o", "\r\n"]
[17.506943, "o", "Введите команду: "]
[18.26029, "o", "select from users\r\n"]
[18.261191, "o", "Функция select выполнилась за 0.000 секунд."]
[18.262194, "o", "\r\n"]
[18.718036, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n+----+--------+-----+-----------+\r\nВведите команду: "]
[19.025743, "o", "update users set age = 29 where name = \"Sergei\"\r\n"]
[19.026665, "o", "Запись с ID=1 в таблице \"users\" успешно обновлена.\r\nВведите команду: "]
[19.787482, "o", "select from users where age = 29\r\nФункция select выполнилась за 0.000 секунд."]
[19.787596, "o", "\r\n"]
[19.788185, "o", "+----+--------+-----+-----------+"]
[19.789411, "o", "\r\n"]
[19.791817, "o", "| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  29 |    True   |\r\n+----+--------+-----+-----------+\r\nВведите команду: "]
[20.552995, "o", "delete from users where ID = 1\r\n"]
[20.553178, "o", "Вы уверены, что хотите выполнить \"удаление записей\"? [y/n]: "]
[21.315385, "o", "n\r\nОперация отменена.\r\nВведите команду: "]
[22.068643, "o", "select from users\r\nФункция select выполнилась за 0.000 секунд.\r\n+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  29 |    True   |\r\n+----+--------+-----+-----------+\r\nВведите команду: "]
[22.822017, "o", "delete from users where ID = 1\r\n"]
[22.823527, "o", "Вы уверены, что хотите выполнить \"удаление записей\"? [y/n]: "]
[23.589902, "o", "y\r\n"]
[23.594629, "o", "Запись с ID=1 в таблице \"users\" успешно удалена."]
[23.594878, "o", "\r\nВведите команду: "]
[24.343784, "o", "info users\r\n"]
[24.345585, "o", "Таблица: users\r\nСтолбцы: ID:int, name:str, age:int, is_active:bool\r\nКоличество записей: 0\r\nВведите команду: "]
[25.099644, "o", "drop_table users\r\n"]
[25.100263, "o", "Вы уверены, что хотите выполнить \"удаление таблицы\"? [y/n]: "]
[25.856898, "o", "y\r\nТаблица \"users\" успешно удалена.\r\nВведите команду: "]
[26.633282, "o", "list_tables\r\n"]
[26.6346, "o", "Введите команду: "]
[27.391764, "o", "exit\r\n"]
[27.423299, "o", "$ "]
[28.144562, "o", "exit"]
[28.145052, "o", "\r\nexit"]
[28.145809, "o", "\r\n"]
